{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Forest Ink", "color": "#16352C" },
        { "slug": "navy", "name": "Deep Forest", "color": "#123C31" },
        { "slug": "evergreen", "name": "Mineral Green", "color": "#2F6A56" },
        { "slug": "sage", "name": "Soft Sage", "color": "#A9C4B3" },
        { "slug": "amber", "name": "Fresh Lime", "color": "#C9F79F" },
        { "slug": "sand", "name": "Warm Limestone", "color": "#E9E4D8" },
        { "slug": "canvas", "name": "Oat Canvas", "color": "#F4F2EA" },
        { "slug": "surface", "name": "Ivory", "color": "#FFFEF9" },
        { "slug": "muted", "name": "Moss Grey", "color": "#66756D" },
        { "slug": "border", "name": "Stone Border", "color": "#D7DCD3" },
        { "slug": "success", "name": "Success", "color": "#3F765A" },
        { "slug": "error", "name": "Error", "color": "#A64B4B" },
        { "slug": "ultramarine", "name": "Slate Blue", "color": "#536D82" },
        { "slug": "electric-purple", "name": "Muted Plum", "color": "#746775" },
        { "slug": "aqua-glow", "name": "Muted Teal", "color": "#64858A" },
        { "slug": "foreground", "name": "Legacy Foreground", "color": "#16352C" },
        { "slug": "background", "name": "Legacy Background", "color": "#F4F2EA" },
        { "slug": "brand", "name": "Legacy Brand", "color": "#2F6A56" },
        { "slug": "accent", "name": "Legacy Accent", "color": "#C9F79F" }
      ],
      "gradients": [
        { "slug": "estate-dusk", "name": "Forest Canopy", "gradient": "linear-gradient(135deg, #123C31 0%, #2F6A56 100%)" },
        { "slug": "warm-listing", "name": "Warm Limestone", "gradient": "linear-gradient(135deg, #FFFEF9 0%, #E9E4D8 100%)" },
        { "slug": "city-night", "name": "Forest Night", "gradient": "linear-gradient(135deg, #102A23 0%, #123C31 100%)" },
        { "slug": "mesh-aurora", "name": "Fresh Sage", "gradient": "linear-gradient(135deg, #F4F2EA 0%, #DDEBDD 55%, #C9F79F 140%)" }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1280px"
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "soft", "name": "Soft", "shadow": "0 8px 24px rgba(18, 60, 49, 0.06)" },
        { "slug": "card", "name": "Card", "shadow": "0 18px 48px rgba(18, 60, 49, 0.11)" },
        { "slug": "floating", "name": "Elevated", "shadow": "0 28px 80px rgba(18, 60, 49, 0.16)" }
      ]
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "2XS", "size": "0.5rem" },
        { "slug": "30", "name": "XS", "size": "0.75rem" },
        { "slug": "40", "name": "S", "size": "1rem" },
        { "slug": "50", "name": "M", "size": "1.25rem" },
        { "slug": "60", "name": "L", "size": "1.75rem" },
        { "slug": "70", "name": "XL", "size": "clamp(2.25rem, 4vw, 3.75rem)" },
        { "slug": "80", "name": "2XL", "size": "clamp(3.25rem, 7vw, 6rem)" }
      ],
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontFamilies": [
        { "slug": "sans", "name": "YourHome Sans", "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
        { "slug": "display", "name": "YourHome Display", "fontFamily": "Iowan Old Style, Baskerville, \"Times New Roman\", serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Body", "size": "1rem" },
        { "slug": "large", "name": "Lead", "size": "clamp(1.125rem, 1.4vw, 1.25rem)" },
        { "slug": "x-large", "name": "Heading", "size": "clamp(1.75rem, 3.5vw, 2.75rem)" },
        { "slug": "hero", "name": "Hero", "size": "clamp(2.5rem, 6vw, 4.5rem)" }
      ]
    },
    "custom": {
      "radius": { "small": "0.75rem", "medium": "1.25rem", "large": "2rem", "pill": "999px" },
      "transition": { "fast": "180ms cubic-bezier(0.2, 0.7, 0.2, 1)", "normal": "420ms cubic-bezier(0.2, 0.7, 0.2, 1)" }
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|canvas", "text": "var:preset|color|ink" },
    "spacing": { "blockGap": "var:preset|spacing|40" },
    "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.6" },
    "elements": {
      "button": {
        "border": { "radius": "var:custom|radius|pill" },
        "color": { "background": "var:preset|color|evergreen", "text": "var:preset|color|surface" },
        "spacing": { "padding": { "top": "0.8rem", "right": "1.25rem", "bottom": "0.8rem", "left": "1.25rem" } },
        "typography": { "fontSize": "0.9375rem", "fontWeight": "700", "lineHeight": "1.2" }
      },
      "caption": { "color": { "text": "var:preset|color|muted" }, "typography": { "fontSize": "var:preset|font-size|small" } },
      "h1": { "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "var:preset|font-size|hero", "fontWeight": "600", "letterSpacing": "-0.035em", "lineHeight": "1.02" } },
      "h2": { "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "var:preset|font-size|x-large", "fontWeight": "600", "letterSpacing": "-0.025em", "lineHeight": "1.1" } },
      "h3": { "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "1.65rem", "fontWeight": "600", "lineHeight": "1.2" } },
      "h4": { "typography": { "fontSize": "1.2rem", "fontWeight": "700", "lineHeight": "1.3" } },
      "link": { "color": { "text": "var:preset|color|evergreen" }, "typography": { "textDecoration": "none" } }
    },
    "blocks": {
      "core/button": { "border": { "radius": "var:custom|radius|pill" }, "shadow": "var:preset|shadow|soft" },
      "core/code": { "border": { "color": "var:preset|color|border", "radius": "var:custom|radius|small", "width": "1px" }, "color": { "background": "var:preset|color|surface", "text": "var:preset|color|ink" }, "spacing": { "padding": "var:preset|spacing|40" } },
      "core/cover": { "border": { "radius": "var:custom|radius|large" }, "spacing": { "padding": "var:preset|spacing|50" } },
      "core/details": { "border": { "color": "var:preset|color|border", "radius": "var:custom|radius|medium", "width": "1px" }, "color": { "background": "var:preset|color|surface" }, "spacing": { "padding": "var:preset|spacing|40" } },
      "core/image": { "border": { "radius": "var:custom|radius|medium" } },
      "core/navigation": { "typography": { "fontSize": "0.9375rem", "fontWeight": "650" } },
      "core/post-date": { "color": { "text": "var:preset|color|muted" }, "typography": { "fontSize": "var:preset|font-size|small" } },
      "core/post-excerpt": { "color": { "text": "var:preset|color|muted" } },
      "core/post-title": { "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600", "lineHeight": "1.15" } },
      "core/pullquote": { "border": { "color": "var:preset|color|amber" }, "color": { "text": "var:preset|color|ink" }, "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "var:preset|font-size|large" } },
      "core/quote": { "border": { "color": "var:preset|color|evergreen", "width": "0 0 0 4px" }, "color": { "background": "var:preset|color|surface" }, "spacing": { "padding": { "top": "var:preset|spacing|40", "right": "var:preset|spacing|50", "bottom": "var:preset|spacing|40", "left": "var:preset|spacing|50" } } },
      "core/search": { "border": { "radius": "var:custom|radius|pill" } },
      "core/separator": { "color": { "background": "var:preset|color|border" } },
      "core/site-title": { "typography": { "fontFamily": "var:preset|font-family|display", "fontSize": "1.5rem", "fontWeight": "700", "letterSpacing": "-0.02em" } },
      "core/table": { "border": { "color": "var:preset|color|border" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
