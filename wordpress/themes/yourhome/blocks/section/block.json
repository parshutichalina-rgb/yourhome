{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yourhome/section",
  "version": "1.3.0",
  "title": "YourHome Section",
  "category": "design",
  "icon": "layout",
  "description": "A structured section for nested Gutenberg blocks.",
  "textdomain": "yourhome",
  "attributes": {
    "heading": { "type": "string", "default": "Section heading" }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false,
    "color": { "background": true, "text": true, "link": true },
    "spacing": { "margin": true, "padding": true }
  },
  "styles": [
    { "name": "default", "label": "Open", "isDefault": true },
    { "name": "glass", "label": "Surface" },
    { "name": "aurora", "label": "Tinted" },
    { "name": "outline", "label": "Outline" }
  ],
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
