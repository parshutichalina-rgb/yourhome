{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yourhome/section",
  "version": "1.0.0",
  "title": "YourHome Section",
  "category": "design",
  "icon": "layout",
  "description": "A structured section for nested Gutenberg blocks.",
  "textdomain": "yourhome",
  "attributes": {
    "heading": { "type": "string", "default": "Section heading" }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false,
    "spacing": { "margin": true, "padding": true }
  },
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
