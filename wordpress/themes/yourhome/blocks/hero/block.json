{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yourhome/hero",
  "version": "1.3.1",
  "title": "YourHome Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "An animated, accessible slider composed from YourHome Hero Slides.",
  "textdomain": "yourhome",
  "attributes": {
    "autoplay": { "type": "boolean", "default": true },
    "interval": { "type": "number", "default": 6000 },
    "transition": { "type": "string", "default": "fade" },
    "showArrows": { "type": "boolean", "default": true },
    "showPagination": { "type": "boolean", "default": true },
    "pauseOnHover": { "type": "boolean", "default": true }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "html": false,
    "spacing": { "margin": true, "padding": true },
    "interactivity": true
  },
  "allowedBlocks": ["yourhome/hero-slide"],
  "styles": [
    { "name": "cinematic", "label": "Editorial", "isDefault": true },
    { "name": "clean", "label": "Clean" },
    { "name": "framed", "label": "Framed" },
    { "name": "aurora", "label": "Light" },
    { "name": "glass", "label": "Bordered" }
  ],
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php",
  "viewScriptModule": "file:./view.js"
}
